# Copy to .env.local and fill in from Google Cloud Console (see README).
# Leave VITE_GOOGLE_CLIENT_ID empty to run the built-in demo mode.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
# Optional: set to 'popup' only as a temporary fallback if the redirect URIs
# are not registered yet (see README → OAuth client). Default is 'redirect'.
VITE_GOOGLE_SIGNIN=
